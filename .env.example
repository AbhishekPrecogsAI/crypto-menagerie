# .env.example — secret material for the scanner's secret / related-crypto
# detection. These are PUBLIC, well-known EXAMPLE values from AWS's own docs
# and RFCs — never real credentials — so the demo is safe to commit.

# AWS example access keys (from AWS documentation — not real).
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# A placeholder HMAC signing secret (webhook signer above).
WEBHOOK_HMAC_SECRET=replace-me-with-a-real-secret

# A placeholder JWT signing key reference (points at the weak RSA key).
JWT_PRIVATE_KEY_PATH=./certs/rsa1024-sha1.key
